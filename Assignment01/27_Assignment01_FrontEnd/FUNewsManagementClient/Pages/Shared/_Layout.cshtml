@using FUNewsManagementClient.DTOs
@using FUNewsManagementClient.Helpers
@inject IHttpContextAccessor HttpContextAccessor
@{
    var currentUser = HttpContextAccessor.HttpContext?.Session.GetObject<LoginResponse>("CurrentUser");
    bool isAdmin = currentUser != null && string.Equals(currentUser.Role, "Admin", StringComparison.OrdinalIgnoreCase);
    bool isStaff = currentUser != null && string.Equals(currentUser.Role, "Staff", StringComparison.OrdinalIgnoreCase);
    bool isLecturer = currentUser != null && string.Equals(currentUser.Role, "Lecturer", StringComparison.OrdinalIgnoreCase);
    string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FU News Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout">
        <!-- LEFT SIDEBAR -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-page="/Index">
                    <div class="brand-gem-icon">
                        <i class="bi bi-newspaper"></i>
                    </div>
                    <div class="brand-text-group">
                        <span class="brand-title">FU NEWS</span>
                        <span class="brand-subtitle">PORTAL & CMS</span>
                    </div>
                </a>
            </div>

            <div class="sidebar-scrollable">
                <div class="sidebar-section-title">Khám phá</div>
                <ul class="sidebar-menu">
                    <li>
                        <a class="sidebar-item @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">
                            <i class="bi bi-compass"></i>
                            <span>Public News</span>
                        </a>
                    </li>
                </ul>

                @if (isAdmin)
                {
                    <div class="sidebar-section-title">Admin Control</div>
                    <ul class="sidebar-menu">
                        <li>
                            <a class="sidebar-item @(currentPage.StartsWith("/Admin/Accounts") ? "active" : "")" asp-page="/Admin/Accounts/Index">
                                <i class="bi bi-people-fill text-danger"></i>
                                <span>Accounts</span>
                                <span class="sidebar-badge badge-admin">Admin</span>
                            </a>
                        </li>
                        <li>
                            <a class="sidebar-item @(currentPage.StartsWith("/Admin/Reports") ? "active" : "")" asp-page="/Admin/Reports/Index">
                                <i class="bi bi-graph-up-arrow text-warning"></i>
                                <span>Report Statistics</span>
                            </a>
                        </li>
                    </ul>
                }

                @if (isStaff)
                {
                    <div class="sidebar-section-title">Staff Editorial</div>
                    <ul class="sidebar-menu">
                        <li>
                            <a class="sidebar-item @(currentPage.StartsWith("/Staff/Articles") ? "active" : "")" asp-page="/Staff/Articles/Index">
                                <i class="bi bi-file-earmark-richtext text-primary"></i>
                                <span>News Articles</span>
                            </a>
                        </li>
                        <li>
                            <a class="sidebar-item @(currentPage.StartsWith("/Staff/Categories") ? "active" : "")" asp-page="/Staff/Categories/Index">
                                <i class="bi bi-folder2-open text-info"></i>
                                <span>Categories</span>
                            </a>
                        </li>
                        <li>
                            <a class="sidebar-item @(currentPage == "/Staff/MyArticles" ? "active" : "")" asp-page="/Staff/MyArticles">
                                <i class="bi bi-clock-history text-success"></i>
                                <span>My History</span>
                            </a>
                        </li>
                        <li>
                            <a class="sidebar-item @(currentPage == "/Staff/Profile" ? "active" : "")" asp-page="/Staff/Profile">
                                <i class="bi bi-person-gear text-light"></i>
                                <span>My Profile</span>
                            </a>
                        </li>
                    </ul>
                }

                @if (isLecturer)
                {
                    <div class="sidebar-section-title">Lecturer Portal</div>
                    <ul class="sidebar-menu">
                        <li>
                            <a class="sidebar-item @(currentPage == "/Staff/Profile" ? "active" : "")" asp-page="/Staff/Profile">
                                <i class="bi bi-person-gear text-info"></i>
                                <span>My Profile</span>
                            </a>
                        </li>
                    </ul>
                }
            </div>

            <!-- USER CARD IN SIDEBAR -->
            <div class="sidebar-user-card">
                @if (currentUser != null)
                {
                    <div class="user-info-row">
                        <div class="user-avatar-gradient">
                            @(string.IsNullOrEmpty(currentUser.AccountName) ? "U" : currentUser.AccountName.Substring(0, 1).ToUpper())
                        </div>
                        <div class="user-details">
                            <div class="user-name text-truncate">@currentUser.AccountName</div>
                            <span class="badge @(isAdmin ? "badge-role-admin" : isStaff ? "badge-role-staff" : "bg-secondary text-white")" style="font-size: 0.68rem; padding: 0.2rem 0.5rem;">
                                @currentUser.Role
                            </span>
                        </div>
                        <a asp-page="/Logout" class="sidebar-logout-btn" title="Sign Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                }
                else
                {
                    <a asp-page="/Login" class="btn btn-primary w-100 btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In Portal
                    </a>
                }
            </div>
        </aside>

        <!-- MAIN APP WRAPPER -->
        <div class="app-main-wrapper">
            <!-- TOPBAR -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" type="button" title="Toggle Navigation">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    <div class="d-none d-md-flex align-items-center">
                        <span class="fw-bold text-dark fs-6">FU News Management Portal</span>
                        <span class="badge bg-light text-primary border border-primary-subtle ms-2">PRN232 Assignment 1</span>
                    </div>
                </div>
                <div class="topbar-right">
                    @if (currentUser != null)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(isAdmin ? "badge-role-admin" : isStaff ? "badge-role-staff" : "bg-secondary text-white")">
                                <i class="bi @(isAdmin ? "bi-shield-lock" : isStaff ? "bi-person-badge" : "bi-book") me-1"></i>
                                @currentUser.Role
                            </span>
                            @if (isStaff || isLecturer)
                            {
                                <a asp-page="/Staff/Profile" class="btn btn-sm btn-outline-primary d-none d-sm-inline-flex align-items-center">
                                    <i class="bi bi-person-circle me-1"></i> @currentUser.AccountName
                                </a>
                            }
                            else
                            {
                                <span class="fw-semibold text-dark small d-none d-sm-inline-block">
                                    <i class="bi bi-person-circle text-danger me-1"></i> @currentUser.AccountName
                                </span>
                            }
                            <a asp-page="/Logout" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        </div>
                    }
                    else
                    {
                        <a asp-page="/Login" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login
                        </a>
                    }
                </div>
            </header>

            <!-- BODY CONTENT -->
            <main class="app-content-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show card-modern mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                        <span>@TempData["SuccessMessage"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show card-modern mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                        <span>@TempData["ErrorMessage"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="app-footer">
                <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center text-muted small">
                    <div>&copy; 2026 - FU News Management System (PRN232 Assignment 1)</div>
                    <div>Created by <strong class="text-dark">Lê Thanh Hùng</strong></div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Responsive sidebar toggle for mobile
        const sidebarToggle = document.getElementById('sidebarToggle');
        const appSidebar = document.getElementById('appSidebar');
        if (sidebarToggle && appSidebar) {
            sidebarToggle.addEventListener('click', function () {
                appSidebar.classList.toggle('sidebar-open');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>