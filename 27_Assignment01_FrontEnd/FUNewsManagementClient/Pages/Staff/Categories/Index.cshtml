@page
@model FUNewsManagementClient.Pages.Staff.Categories.IndexModel
@{
    ViewData["Title"] = "Category Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Category Management</h2>
        <p class="text-muted mb-0">Manage news article categories and classifications</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-folder-plus me-1"></i> Add New Category
    </button>
</div>

<!-- Search Bar -->
<div class="card card-modern p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="Keyword" class="form-control border-start-0" placeholder="Search by category name or description..." value="@Model.Keyword" />
            </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.Keyword))
            {
                <a asp-page="./Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </form>
</div>

<!-- Categories Table -->
<div class="card card-modern">
    <div class="table-responsive">
        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Parent Category</th>
                    <th>Status</th>
                    <th>Articles Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categories == null || !Model.Categories.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No categories found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var cat in Model.Categories)
                    {
                        <tr>
                            <td class="fw-semibold">#@cat.CategoryId</td>
                            <td class="fw-bold text-dark">@cat.CategoryName</td>
                            <td class="text-secondary small" style="max-width: 250px;">@cat.CategoryDesciption</td>
                            <td>
                                @if (!string.IsNullOrEmpty(cat.ParentCategoryName))
                                {
                                    <span class="badge bg-light text-secondary border">@cat.ParentCategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                            <td>
                                @if (cat.IsActive == true)
                                {
                                    <span class="badge badge-active"><i class="bi bi-check-circle me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive"><i class="bi bi-dash-circle me-1"></i>Inactive</span>
                                }
                            </td>
                            <td>
                                @if (cat.ArticleCount > 0)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        @cat.ArticleCount articles
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">0 articles</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-primary btn-sm me-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editCategoryModal"
                                        data-id="@cat.CategoryId"
                                        data-name="@cat.CategoryName"
                                        data-desc="@cat.CategoryDesciption"
                                        data-parent="@cat.ParentCategoryId"
                                        data-active="@(cat.IsActive == true ? "true" : "false")">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteCategoryModal"
                                        data-id="@cat.CategoryId"
                                        data-name="@cat.CategoryName"
                                        data-count="@cat.ArticleCount">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Category Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-folder-plus text-primary me-2"></i>Create New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Category Name <span class="text-danger">*</span></label>
                        <input asp-for="CategoryInput.CategoryName" class="form-control" placeholder="e.g. Campus News" required />
                        <span asp-validation-for="CategoryInput.CategoryName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Category Description <span class="text-danger">*</span></label>
                        <textarea asp-for="CategoryInput.CategoryDesciption" class="form-control" rows="3" placeholder="Brief description of the category..." required></textarea>
                        <span asp-validation-for="CategoryInput.CategoryDesciption" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Parent Category</label>
                        <select asp-for="CategoryInput.ParentCategoryId" class="form-select">
                            <option value="">-- None (Top Level) --</option>
                            @if (Model.Categories != null)
                            {
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" name="CategoryInput.IsActive" value="true" class="form-check-input" checked />
                        <label class="form-check-label fw-semibold small">Active Category</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <input type="hidden" id="editCategoryId" name="CategoryInput.CategoryId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Category ID</label>
                        <input id="editCategoryIdDisplay" class="form-control bg-light" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Category Name <span class="text-danger">*</span></label>
                        <input id="editCategoryName" name="CategoryInput.CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Category Description <span class="text-danger">*</span></label>
                        <textarea id="editCategoryDesc" name="CategoryInput.CategoryDesciption" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Parent Category</label>
                        <select id="editParentCategory" name="CategoryInput.ParentCategoryId" class="form-select">
                            <option value="">-- None (Top Level) --</option>
                            @if (Model.Categories != null)
                            {
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input id="editIsActive" name="CategoryInput.IsActive" class="form-check-input" type="checkbox" value="true" />
                        <label class="form-check-label fw-semibold small">Active Category</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Update Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" id="deleteCatId" name="categoryId" />
                <div class="modal-header bg-danger-subtle">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-2">Are you sure you want to permanently delete category: <strong id="deleteCatName" class="text-danger"></strong>?</p>
                    <div id="deleteCatWarning" class="alert alert-warning small mb-0" style="display: none;">
                        <i class="bi bi-info-circle me-1"></i> Warning: This category has news articles stored in it. The system will prevent deletion!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editCatModal = document.getElementById('editCategoryModal');
        if (editCatModal) {
            editCatModal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                const desc = btn.getAttribute('data-desc');
                const parent = btn.getAttribute('data-parent');
                const active = btn.getAttribute('data-active') === 'true';

                document.getElementById('editCategoryId').value = id;
                document.getElementById('editCategoryIdDisplay').value = '#' + id;
                document.getElementById('editCategoryName').value = name || '';
                document.getElementById('editCategoryDesc').value = desc || '';
                document.getElementById('editParentCategory').value = parent || '';
                document.getElementById('editIsActive').checked = active;
            });
        }

        const deleteCatModal = document.getElementById('deleteCategoryModal');
        if (deleteCatModal) {
            deleteCatModal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                const count = parseInt(btn.getAttribute('data-count') || '0');

                document.getElementById('deleteCatId').value = id;
                document.getElementById('deleteCatName').textContent = name + ' (#' + id + ')';
                const warning = document.getElementById('deleteCatWarning');
                if (count > 0) {
                    warning.style.display = 'block';
                    warning.innerHTML = `<i class="bi bi-exclamation-octagon me-1"></i> Warning: This category is linked with <strong>${count}</strong> article(s). Server will reject deletion!`;
                } else {
                    warning.style.display = 'none';
                }
            });
        }
    </script>
}
