@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card card-modern p-4">
            <div class="text-center mb-4">
                <div class="brand-logo justify-content-center fs-3 mb-2">
                    <i class="bi bi-newspaper text-primary"></i>
                    <span>FU News</span>
                </div>
                <h4 class="fw-bold text-dark">Sign In</h4>
                <p class="text-muted small">Enter your credentials to access system features</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger small py-2 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="LoginInput.Email" type="email" class="form-control border-start-0" placeholder="name@domain.org" required />
                    </div>
                    <span asp-validation-for="LoginInput.Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-key text-muted"></i></span>
                        <input asp-for="LoginInput.Password" type="password" class="form-control border-start-0" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="LoginInput.Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>

            <div class="bg-light p-3 rounded-3 mt-3 border">
                <div class="fw-semibold small text-muted mb-2"><i class="bi bi-info-circle me-1"></i> Quick Test Accounts:</div>
                <div class="small text-secondary mb-1">
                    <strong>Admin:</strong> <code class="text-primary">admin@FUNewsManagementSystem.org</code> / <code class="text-dark">admin</code>
                </div>
                <div class="small text-secondary">
                    <strong>Staff (Role 1):</strong> <code class="text-primary">IsabellaDavid@FUNewsManagement.org</code> / <code class="text-dark">@@1</code>
                </div>
            </div>
        </div>
    </div>
</div>
