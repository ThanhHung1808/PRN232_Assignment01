@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 col-xl-5" style="max-width: 620px;">
        <div class="card card-modern p-4 p-md-5 shadow-lg border-0">
            <div class="text-center mb-4">
                <div class="brand-icon-wrapper mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
                    <i class="bi bi-newspaper"></i>
                </div>
                <div class="brand-logo justify-content-center fs-3 mb-1">
                    <span>FU News Portal</span>
                </div>
                <p class="text-muted small">Sign in to your account</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger small py-2 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-primary"></i></span>
                        <input asp-for="LoginInput.Email" type="email" class="form-control border-start-0" placeholder="name@domain.org" required />
                    </div>
                    <span asp-validation-for="LoginInput.Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-key text-primary"></i></span>
                        <input asp-for="LoginInput.Password" type="password" class="form-control border-start-0" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="LoginInput.Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3 shadow">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>

            <div class="p-3 rounded-4 mt-3" style="background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%); border: 1px solid #e0e7ff;">
                <div class="fw-semibold small text-primary mb-2"><i class="bi bi-key-fill me-1"></i> Quick Test Accounts:</div>
                <div class="small text-secondary mb-1">
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-1">Admin</span> <code class="text-dark fw-semibold">admin@FUNewsManagementSystem.org</code> / <code>admin</code>
                </div>
                <div class="small text-secondary">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">Staff</span> <code class="text-dark fw-semibold">IsabellaDavid@FUNewsManagement.org</code> / <code>@@1</code>
                </div>
            </div>
        </div>
    </div>
</div>
