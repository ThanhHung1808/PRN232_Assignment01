@using FUNewsManagementClient.DTOs
@using FUNewsManagementClient.Helpers
@inject IHttpContextAccessor HttpContextAccessor
@{
    var currentUser = HttpContextAccessor.HttpContext?.Session.GetObject<LoginResponse>("CurrentUser");
    bool isAdmin = currentUser != null && string.Equals(currentUser.Role, "Admin", StringComparison.OrdinalIgnoreCase);
    bool isStaff = currentUser != null && string.Equals(currentUser.Role, "Staff", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FU News Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container-fluid px-4">
                <a class="brand-logo" asp-page="/Index">
                    <i class="bi bi-newspaper fs-4 text-primary"></i>
                    <span>FU News</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index"><i class="bi bi-house-door me-1"></i> Public News</a>
                        </li>

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/Accounts/Index"><i class="bi bi-people me-1"></i> Account Management</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/Reports/Index"><i class="bi bi-bar-chart-line me-1"></i> Report Statistics</a>
                            </li>
                        }

                        @if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/Articles/Index"><i class="bi bi-file-earmark-text me-1"></i> News Articles</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/Categories/Index"><i class="bi bi-tags me-1"></i> Categories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/MyArticles"><i class="bi bi-clock-history me-1"></i> My History</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (currentUser != null)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(isAdmin ? "badge-role-admin" : "badge-role-staff")">
                                    <i class="bi @(isAdmin ? "bi-shield-lock" : "bi-person-badge") me-1"></i>
                                    @currentUser.Role
                                </span>
                                @if (isStaff)
                                {
                                    <a asp-page="/Staff/Profile" class="text-decoration-none fw-semibold text-dark hover-primary" title="Edit Profile">
                                        <i class="bi bi-person-circle fs-5 me-1 text-primary"></i>
                                        <span>@currentUser.AccountName</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="fw-semibold text-dark">
                                        <i class="bi bi-person-circle fs-5 me-1 text-danger"></i>
                                        @currentUser.AccountName
                                    </span>
                                }
                            </div>
                            <a asp-page="/Logout" class="btn btn-outline-danger btn-sm px-3">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Login" class="btn btn-primary px-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show card-modern mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                <span>@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show card-modern mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container-fluid px-4 text-center">
            <div>&copy; 2026 - FU News Management System (PRN232 Assignment 1)</div>
            <div class="mt-1">Created by Lê Thanh Hùng</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>