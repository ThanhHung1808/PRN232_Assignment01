@page
@model IndexModel
@{
    ViewData["Title"] = "Public News Portal";
}

<div class="p-4 mb-4 bg-white rounded-3 card-modern border-0">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold text-dark mb-2">Welcome to FU News Portal</h1>
            <p class="text-muted mb-0">Stay updated with the latest university announcements, academic research, student activities, and alumni achievements.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
                <i class="bi bi-newspaper me-1"></i> @Model.Articles.Count Articles Available
            </span>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card card-modern p-3 mb-4">
    <form method="get" class="row g-3 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="Keyword" class="form-control border-start-0" placeholder="Search by title, headline or content..." value="@Model.Keyword" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="CategoryId" class="form-select">
                <option value="">-- All Categories --</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">@cat.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
            @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.CategoryId.HasValue)
            {
                <a asp-page="/Index" class="btn btn-outline-secondary" title="Reset filter"><i class="bi bi-arrow-counterclockwise"></i></a>
            }
        </div>
    </form>
</div>

<!-- Articles Grid -->
@if (Model.Articles == null || !Model.Articles.Any())
{
    <div class="card card-modern text-center p-5">
        <i class="bi bi-inbox text-muted display-4 mb-3"></i>
        <h4 class="text-secondary">No news articles found</h4>
        <p class="text-muted">Try adjusting your search criteria or check back later.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var article in Model.Articles)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-modern h-100 d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-light text-primary border border-primary-subtle fw-semibold">
                                <i class="bi bi-folder me-1"></i>@(article.CategoryName ?? "General")
                            </span>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>@(article.CreatedDate?.ToString("dd/MM/yyyy") ?? "N/A")
                            </small>
                        </div>
                        <h5 class="card-title fw-bold text-dark mt-2 mb-2 line-clamp-2">
                            @article.Headline
                        </h5>
                        @if (!string.IsNullOrWhiteSpace(article.NewsTitle) && article.NewsTitle != article.Headline)
                        {
                            <h6 class="text-muted fs-6 mb-2">@article.NewsTitle</h6>
                        }
                        <p class="card-text text-secondary mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @article.NewsContent
                        </p>
                        
                        <div class="mb-3">
                            @foreach (var tag in article.Tags)
                            {
                                <span class="badge-tag">#@tag.TagName</span>
                            }
                        </div>

                        <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">
                                <i class="bi bi-person me-1"></i>@(article.CreatedByName ?? "FU Staff")
                            </small>
                            <button type="button" class="btn btn-outline-primary btn-sm px-3" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#viewArticleModal"
                                    data-id="@article.NewsArticleId"
                                    data-headline="@article.Headline"
                                    data-title="@article.NewsTitle"
                                    data-content="@article.NewsContent"
                                    data-source="@article.NewsSource"
                                    data-date="@(article.CreatedDate?.ToString("dd/MM/yyyy HH:mm"))"
                                    data-category="@article.CategoryName"
                                    data-author="@article.CreatedByName"
                                    data-tags="@string.Join(", ", article.Tags.Select(t => t.TagName))">
                                Read More <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Detail Modal -->
<div class="modal fade" id="viewArticleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span id="modalCategory" class="badge bg-primary mb-1"></span>
                    <h5 class="modal-title fw-bold" id="modalHeadline"></h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between text-muted border-bottom pb-2 mb-3">
                    <small><i class="bi bi-person me-1"></i> Author: <span id="modalAuthor" class="fw-semibold"></span></small>
                    <small><i class="bi bi-calendar-event me-1"></i> <span id="modalDate"></span></small>
                </div>
                <h6 id="modalTitle" class="fw-semibold text-secondary mb-3"></h6>
                <div id="modalContent" class="text-dark" style="white-space: pre-line; line-height: 1.7;"></div>
                <hr />
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <small class="text-muted"><i class="bi bi-globe me-1"></i> Source: <span id="modalSource" class="fw-semibold"></span></small>
                    <div><span class="text-muted me-1">Tags:</span> <span id="modalTags"></span></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('viewArticleModal');
        if (modal) {
            modal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                document.getElementById('modalHeadline').textContent = btn.getAttribute('data-headline') || '';
                document.getElementById('modalTitle').textContent = btn.getAttribute('data-title') || '';
                document.getElementById('modalContent').textContent = btn.getAttribute('data-content') || '';
                document.getElementById('modalSource').textContent = btn.getAttribute('data-source') || 'N/A';
                document.getElementById('modalDate').textContent = btn.getAttribute('data-date') || '';
                document.getElementById('modalCategory').textContent = btn.getAttribute('data-category') || 'General';
                document.getElementById('modalAuthor').textContent = btn.getAttribute('data-author') || 'FU Staff';
                
                const tagsStr = btn.getAttribute('data-tags') || '';
                const tagsContainer = document.getElementById('modalTags');
                tagsContainer.innerHTML = '';
                if (tagsStr) {
                    tagsStr.split(',').forEach(tag => {
                        const span = document.createElement('span');
                        span.className = 'badge-tag';
                        span.textContent = '#' + tag.trim();
                        tagsContainer.appendChild(span);
                    });
                }
            });
        }
    </script>
}
